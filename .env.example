# Corriendo el backend a mano, loopback. En el contenedor va en 0.0.0.0, que ahí
# no expone nada: es el namespace de red del contenedor y es lo único que permite
# que nginx lo alcance.
HOST=127.0.0.1
PORT=3000

# Ruta del archivo SQLite (RNF-3: un único archivo copiable)
DATABASE_PATH=./data/personal.sqlite

# RNF-S2: sin estos dos el proceso no arranca. No tienen default a propósito.
# `pnpm hash-password` imprime la línea entera lista para pegar acá.
PASSWORD_HASH=
# `openssl rand -hex 32`. Cambiarlo cierra la sesión en todos los dispositivos.
SESSION_SECRET=

# Queda en false: no hay HTTPS (RNF-S4). Sobre HTTP plano una cookie Secure se
# descarta sin aviso y el login queda en un bucle.
COOKIE_SECURE=false
