{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,

    // El backend no tiene paso de build: Node ejecuta los .ts por type stripping
    // nativo. tsc es solo el typecheck, y estas tres opciones son las que evitan
    // que compile algo que en runtime no se puede borrar (stack.md §2).
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src", "drizzle.config.ts"]
}
